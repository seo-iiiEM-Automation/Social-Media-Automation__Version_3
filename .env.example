# Copy this file to .env and fill in your real values. Never commit .env.

# OpenAI (ChatGPT + DALL-E)
OPENAI_API_KEY=sk-...

# Facebook Page
FB_PAGE_ID=your_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# Instagram Professional account (must be linked to the Facebook Page above)
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_access_token
